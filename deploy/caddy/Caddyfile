# DOMAIN comes from .env:
#   pre-prod / prod : <ip-with-dashes>.sslip.io or example.org -> automatic HTTPS (Let's Encrypt)
#   local test      : http://localhost                         -> plain HTTP
{$DOMAIN} {
	encode gzip
	header {
		# No framing of the site (clickjacking), no MIME sniffing, no full URL sent to other sites
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Access log read by fail2ban on the host (see deploy/fail2ban)
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json {
			time_format iso8601
		}
	}
	reverse_proxy app:8000
}
