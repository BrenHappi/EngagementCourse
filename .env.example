ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

SECRET_KEY=replace_with_secure_secret

FLASK_APP=engagement_course.app:create_app
LOG_LEVEL=INFO

# Public address. Pre-prod without a domain: <ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
# DOMAIN drives Caddy (HTTPS is automatic for a real host name; use http://localhost to test locally)
DOMAIN=http://localhost
EXTERNAL_URL=http://localhost

# Server only: lets `docker compose up -d` start the prod services without --profile
# COMPOSE_PROFILES=prod
# Gunicorn workers (2 fits a 512 MB server)
# WEB_CONCURRENCY=2
# Server only: pins the deployed image to one build, for a rollback (see DEPLOY.md).
# While it is set, automatic deployments stay on that tag.
# APP_TAG=<commit sha>

SMTP_HOSTNAME=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password
